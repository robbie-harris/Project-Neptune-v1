<?xml version="1.0"?>
<scenario>
	<solver>
		<multithreading max_physics_threads="8"/>
	</solver>

	<environment>
		<ned latitude="40.0" longitude="3.0"/>

		<ocean>
			<water density="1000.0" jerlov="0.25"/>
			<waves height="0.0"/>
			<current type="uniform">
				<velocity xyz="1.0 0.0 0.0"/>
			</current>
			<!-- <current type="jet">
				<center xyz="0.0 0.0 2.0"/>
				<outlet radius="0.2"/>
				<velocity xyz="1.0 1.0 0.0"/>
			</current> -->
		</ocean>

		<atmosphere>
			<sun azimuth="120.0" elevation="50.0"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.5"/>
		<material name="Rock" density="3000.0" restitution="0.8"/>
		<material name="Fiberglass" density="1500.0" restitution="0.3"/>
		<material name="Aluminium" density="2710.0" restitution="0.7"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
		</friction_table>
	</materials>

	<looks>
		<look name="yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
		<look name="gray" gray="0.3" roughness="0.4" metalness="0.5"/>
		<look name="seabed" rgb="0.7 0.7 0.5" roughness="0.9"/>
		<look name="propeller" gray="1.0" roughness="0.3" texture="propeller_tex.png"/>
		<look name="duct" gray="0.1" roughness="0.4" metalness="0.5"/>
		<look name="dark" rgb="0.2 0.15 0.1" roughness="0.6" metalness="0.8"/>
		<look name="pipe" rgb="1.0 0.2 0.0" roughness="0.2" metalness="0.3"/>

        <look name="neptune_home_red" rgb="1.0 0.15 0.15" roughness="0.3" metalness="0.0"/>
        <look name="neptune_goal_yellow" rgb="1.0 0.9 0.1" roughness="0.3" metalness="0.0"/>
        <look name="neptune_goal_blue" rgb="0.1 0.4 1.0" roughness="0.3" metalness="0.0"/>

            <look name="neptune_pipe" rgb="1.0 0.25 0.0" roughness="0.2" metalness="0.3"/>
        <look name="neptune_target" rgb="1.0 0.85 0.0" roughness="0.3" metalness="0.2"/>
            <look name="dock_blue" rgb="0.05 0.25 0.8" roughness="0.35" metalness="0.4"/>
        <look name="dock_white" rgb="0.85 0.9 0.95" roughness="0.4" metalness="0.3"/>
        <look name="mission_pipe" rgb="1.0 0.3 0.02" roughness="0.25" metalness="0.3"/>
        <look name="route_marker" rgb="0.1 1.0 0.35" roughness="0.3" metalness="0.2"/>
        <look name="perception_flange" rgb="0.65 0.67 0.7" roughness="0.45"/>
        <look name="perception_valve" rgb="0.18 0.48 0.65" roughness="0.45"/>
    </looks>

	<static name="Bottom" type="plane">
		<material name="Rock"/>
		<look name="seabed"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 40.0"/>
	</static>

	<dynamic name="Buoy" type="sphere" physics="submerged" buoyant="true">
		<dimensions radius="0.3"/>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<material name="Neutral"/>
		<look name="yellow"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="5.0 0.0 1.0"/>
	</dynamic>

    <include file="neptune_girona.scn">
		<arg name="robot_name" value="GIRONA500"/>
		<arg name="robot_position" value="0.0 0.0 1.0"/>
	</include>

	<cable name="Cable1" physics="submerged" buoyant="false">
		<geometry diameter="0.02" number_of_segments="100"/>
		<material name="Fiberglass"/>
		<look name="pipe"/>
		<first_end position="2.0 0.0 -1.0" anchor="world"/>
		<second_end position="10.0 0.0 -1.0" anchor="dynamic">
			<body name="Buoy"/>
		</second_end>
	</cable>







    <!-- NEPTUNE_PORT_PIPE_MISSION_START -->

    <!-- ===================================================== -->
    <!-- HOME DOCK: U-shaped launch/return bay, opening to -X -->
    <!-- ===================================================== -->

    <static name="DockPortDeck" type="box">
        <dimensions xyz="6.0 0.8 0.35"/>
        <material name="Aluminium"/>
        <look name="dock_blue"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="1.0 2.3 0.20"/>
    </static>

    <static name="DockStarboardDeck" type="box">
        <dimensions xyz="6.0 0.8 0.35"/>
        <material name="Aluminium"/>
        <look name="dock_blue"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="1.0 -2.3 0.20"/>
    </static>

    <static name="DockRearDeck" type="box">
        <dimensions xyz="1.0 5.4 0.35"/>
        <material name="Aluminium"/>
        <look name="dock_blue"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="3.6 0.0 0.20"/>
    </static>

    <!-- Dock pilings -->
    <static name="DockPile1" type="cylinder">
        <dimensions radius="0.22" height="4.8"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-1.5 2.3 2.4"/>
    </static>

    <static name="DockPile2" type="cylinder">
        <dimensions radius="0.22" height="4.8"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-1.5 -2.3 2.4"/>
    </static>

    <static name="DockPile3" type="cylinder">
        <dimensions radius="0.22" height="4.8"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="3.2 2.3 2.4"/>
    </static>

    <static name="DockPile4" type="cylinder">
        <dimensions radius="0.22" height="4.8"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="3.2 -2.3 2.4"/>
    </static>


    <!-- ===================================================== -->
    <!-- MID-COURSE GATE: 10 m from home -->
    <!-- ===================================================== -->

    <static name="MidMarkerPort" type="cylinder">
        <dimensions radius="0.15" height="4.0"/>
        <material name="Fiberglass"/>
        <look name="route_marker"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-10.0 4.0 3.0"/>
    </static>

    <static name="MidMarkerStarboard" type="cylinder">
        <dimensions radius="0.15" height="4.0"/>
        <material name="Fiberglass"/>
        <look name="route_marker"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-10.0 -4.0 3.0"/>
    </static>


    <!-- ===================================================== -->
    <!-- INSPECTION ASSET: 20 m from HOME -->
    <!-- ===================================================== -->

    <!-- Main subsea pipe -->
    <static name="InspectionPipe" type="cylinder">
        <dimensions radius="0.2" height="4.0"/>
        <material name="Fiberglass"/>
        <look name="mission_pipe"/>
        <world_transform rpy="1.5707963267948966 0.0 0.0" xyz="-20.0 0.0 3.2"/>
    </static>

    <!-- Optional P1a fixture: donor mesh bore is local Y, matching the pipe axis. -->
    <static name="InspectionFlange" type="model">
        <physical>
            <mesh filename="$(find neptune_sim)/assets/perception/flange.obj" scale="1.0" convex="false"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="$(find neptune_sim)/assets/perception/flange.obj" scale="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Aluminium"/>
        <look name="perception_flange"/>
        <world_transform xyz="-20.0 0.85 3.2" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- P1b: body surrounds the pipe; local -Z stem/handwheel points upward in NED. -->
    <static name="InspectionValve" type="model">
        <physical>
            <mesh filename="$(find neptune_sim)/assets/perception/valve.obj" scale="1.0" convex="false"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="$(find neptune_sim)/assets/perception/valve.obj" scale="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Aluminium"/>
        <look name="perception_valve"/>
        <world_transform xyz="-20.0 -0.85 3.2" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Pipe support legs -->
    <static name="PipeSupportPort" type="cylinder">
        <dimensions radius="0.20" height="3.2"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-20.0 2.5 3.4"/>
    </static>

    <static name="PipeSupportStarboard" type="cylinder">
        <dimensions radius="0.20" height="3.2"/>
        <material name="Aluminium"/>
        <look name="dock_white"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-20.0 -2.5 3.4"/>
    </static>

    <!-- Inspection panel beside pipe -->
    <static name="InspectionPanel" type="box">
        <dimensions xyz="0.30 2.0 2.0"/>
        <material name="Aluminium"/>
        <look name="dock_blue"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-21.0 0.0 3.0"/>
    </static>

    <!-- NEPTUNE_PORT_PIPE_MISSION_END -->

</scenario>

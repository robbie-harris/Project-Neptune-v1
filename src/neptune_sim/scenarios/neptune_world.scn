<?xml version="1.0"?>
<scenario>
	<solver>
		<multithreading max_physics_threads="8"/>
	</solver>

	<environment>
		<ned latitude="40.0" longitude="3.0"/>

		<ocean>
			<water density="1000.0" jerlov="0.25"/>
			<waves height="0.0"/>
			<current type="uniform">
				<velocity xyz="1.0 0.0 0.0"/>
			</current>
			<!-- <current type="jet">
				<center xyz="0.0 0.0 2.0"/>
				<outlet radius="0.2"/>
				<velocity xyz="1.0 1.0 0.0"/>
			</current> -->
		</ocean>

		<atmosphere>
			<sun azimuth="120.0" elevation="50.0"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.5"/>
		<material name="Rock" density="3000.0" restitution="0.8"/>
		<material name="Fiberglass" density="1500.0" restitution="0.3"/>
		<material name="Aluminium" density="2710.0" restitution="0.7"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
		</friction_table>
	</materials>

	<looks>
		<look name="yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
		<look name="gray" gray="0.3" roughness="0.4" metalness="0.5"/>
		<look name="seabed" rgb="0.7 0.7 0.5" roughness="0.9"/>
		<look name="propeller" gray="1.0" roughness="0.3" texture="propeller_tex.png"/>
		<look name="duct" gray="0.1" roughness="0.4" metalness="0.5"/>
		<look name="dark" rgb="0.2 0.15 0.1" roughness="0.6" metalness="0.8"/>
		<look name="pipe" rgb="1.0 0.2 0.0" roughness="0.2" metalness="0.3"/>

        <look name="neptune_home_red" rgb="1.0 0.15 0.15" roughness="0.3" metalness="0.0"/>
        <look name="neptune_goal_yellow" rgb="1.0 0.9 0.1" roughness="0.3" metalness="0.0"/>
        <look name="neptune_goal_blue" rgb="0.1 0.4 1.0" roughness="0.3" metalness="0.0"/>

    </looks>

	<static name="Bottom" type="plane">
		<material name="Rock"/>
		<look name="seabed"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 40.0"/>
	</static>

	<dynamic name="Buoy" type="sphere" physics="submerged" buoyant="true">
		<dimensions radius="0.3"/>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<material name="Neutral"/>
		<look name="yellow"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="5.0 0.0 1.0"/>
	</dynamic>

    <include file="neptune_girona.scn">
		<arg name="robot_name" value="GIRONA500"/>
		<arg name="robot_position" value="0.0 0.0 1.0"/>
	</include>

	<cable name="Cable1" physics="submerged" buoyant="false">
		<geometry diameter="0.02" number_of_segments="100"/>
		<material name="Fiberglass"/>
		<look name="pipe"/>
		<first_end position="2.0 0.0 -1.0" anchor="world"/>
		<second_end position="10.0 0.0 -1.0" anchor="dynamic">
			<body name="Buoy"/>
		</second_end>
	</cable>

    <!-- NEPTUNE_DEBUG_MARKERS_START -->

    <!-- HOME marker near start -->
    <static name="HomePole" type="cylinder">
            <dimensions radius="0.15" height="4.0"/>
            <material name="Rock"/>
            <look name="neptune_home_red"/>
            <world_transform xyz="0.0 3.0 2.0" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="HomeCrossBar" type="box">
            <dimensions xyz="1.6 0.15 0.15"/>
            <material name="Rock"/>
            <look name="neptune_home_red"/>
            <world_transform xyz="0.0 3.0 1.0" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Goal structure 10 m forward -->
    <static name="GoalLeftPost" type="cylinder">
            <dimensions radius="0.15" height="4.0"/>
            <material name="Aluminium"/>
            <look name="neptune_goal_yellow"/>
            <world_transform xyz="-10.0 -1.0 2.0" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="GoalRightPost" type="cylinder">
            <dimensions radius="0.15" height="4.0"/>
            <material name="Aluminium"/>
            <look name="neptune_goal_yellow"/>
            <world_transform xyz="-10.0 1.0 2.0" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="GoalTopBar" type="box">
            <dimensions xyz="0.15 2.3 0.15"/>
            <material name="Aluminium"/>
            <look name="neptune_goal_yellow"/>
            <world_transform xyz="-10.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
    </static>

    <static name="GoalBackboard" type="box">
            <dimensions xyz="0.12 2.6 2.0"/>
            <material name="Rock"/>
            <look name="neptune_goal_blue"/>
            <world_transform xyz="-11.0 0.0 2.2" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Extra mid-range marker -->
    <static name="MidMarker" type="box">
            <dimensions xyz="0.4 0.4 0.4"/>
            <material name="Rock"/>
            <look name="neptune_goal_blue"/>
            <world_transform xyz="-5.0 0.0 2.5" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- NEPTUNE_DEBUG_MARKERS_END -->

</scenario>
